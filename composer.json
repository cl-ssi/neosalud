{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-soap": "*",
        "actived/microsoft-teams-notifier": "*",
        "barryvdh/laravel-debugbar": "^3.8",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^3.4",
        "econea/nusoap": "^0.9.11",
        "firebase/php-jwt": "^6.0",
        "google/cloud-error-reporting": "^0.19.3",
        "google/cloud-logging": "^1.24",
        "guzzlehttp/guzzle": "^7.5",
        "laravel/framework": "^10.0",
        "laravel/passport": "^11.0",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.0",
        "lcobucci/clock": "^2.2|^3.0",
        "lcobucci/jwt": "^4.1|^5.0",
        "league/commonmark": "^2.6.0",
        "livewire/livewire": "^2.12.7",
        "maatwebsite/excel": "^3.1",
        "nunomaduro/collision": "^7.0",
        "owen-it/laravel-auditing": "^13.0",
        "phpoffice/phpspreadsheet": "^1.30.5",
        "phpseclib/phpseclib": "^3.0.54",
        "snapappointments/bootstrap-select": "^1.13",
        "spatie/laravel-google-cloud-storage": "^2.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-permission": "^5.10|^6.0",
        "stackkit/laravel-google-cloud-tasks-queue": "^3.3",
        "symfony/http-foundation": "^6.4",
        "symfony/process": "^6.4",
        "twilio/sdk": "^6.24"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}